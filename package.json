{
  "name": "paint-cat",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The classic Windows Paint in your browser. No server, no sign-up, works offline.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1"
  }
}
